GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\firebase-service-account.json
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://[::1]:8080,http://[::]:8080,http://192.168.10.3:8080
PORT=3000
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_COMPANY=
BOOTSTRAP_ADMIN_ADDRESS=
# Use the verified workspace admin mailbox below. For Gmail use smtp.gmail.com,
# port 465, SMTP_SECURE=true, and a 16-character Google App Password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=admin@yourcompany.com
SMTP_PASS=
SMTP_FROM=admin@yourcompany.com
# Optional Twilio delivery for scheduled crew jobs. Crew mobile numbers must
# include their country code, for example +919876543210.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Leave blank to use TWILIO_FROM for voice calls.
TWILIO_VOICE_FROM=
